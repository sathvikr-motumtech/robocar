# motumtech.in — web server rules (Hostinger LiteSpeed / Apache compatible).
# Hugo copies this file unchanged into the published site.

Options -Indexes
ErrorDocument 404 /404.html
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ---------------------------------------------------------------------------
# 1. HTTPS everywhere, and www.motumtech.in -> motumtech.in
#    (other hosts, e.g. new.motumtech.in used for testing, are left alone)
# ---------------------------------------------------------------------------
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.motumtech\.in$ [NC]
RewriteRule ^ https://motumtech.in%{REQUEST_URI} [R=301,L]

# ---------------------------------------------------------------------------
# 2. WordPress is gone: answer bots probing for it with "410 Gone"
# ---------------------------------------------------------------------------
RewriteRule ^(wp-admin|wp-includes|wp-json)(/|$) - [G,L]
RewriteRule ^(wp-login|xmlrpc|wp-cron|wp-config|wp-signup|wp-trackback)\.php$ - [G,L]

# ---------------------------------------------------------------------------
# 3. Old WordPress URLs -> new locations (301 = moved permanently)
# ---------------------------------------------------------------------------

# Short links (?p=ID, ?page_id=ID, ?attachment_id=ID) — only on the home page path
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=8(&|$)
RewriteRule ^$ /about-me/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=12(&|$)
RewriteRule ^$ /day-1-setting-up-arduino-and-gathering-parts/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=21(&|$)
RewriteRule ^$ /day-2-spinning-the-wheels/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=32(&|$)
RewriteRule ^$ /privacy-policy/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=35(&|$)
RewriteRule ^$ /day-3-controlling-the-robot-wirelessly/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)p=47(&|$)
RewriteRule ^$ /part-4-upgrading-to-raspberry-pi/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)attachment_id=(14|16|18|19)(&|$)
RewriteRule ^$ /day-1-setting-up-arduino-and-gathering-parts/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)attachment_id=(24|25|26|27|28|29)(&|$)
RewriteRule ^$ /day-2-spinning-the-wheels/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)attachment_id=(37|39)(&|$)
RewriteRule ^$ /day-3-controlling-the-robot-wirelessly/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)attachment_id=54(&|$)
RewriteRule ^$ /part-4-upgrading-to-raspberry-pi/? [R=301,L]

# Renamed page
RewriteRule ^privacy-policy-2/?$ /privacy-policy/ [R=301,L]

# Feeds and sitemaps
RewriteRule ^(.+/)?feed(/.*)?$ /index.xml [R=301,L]
RewriteRule ^(wp-sitemap|sitemap_index|post-sitemap|page-sitemap)\.xml$ /sitemap.xml [R=301,L]

# Taxonomy and archive pages
RewriteRule ^category/uncategorized/?$ /categories/robotics/ [R=301,L]
RewriteRule ^category/([^/]+)/?$ /categories/$1/ [R=301,L]
RewriteRule ^tag/([^/]+)/?$ /tags/$1/ [R=301,L]
RewriteRule ^author/ /about-me/ [R=301,L]
RewriteRule ^20[0-9][0-9](/[0-9]{2})?(/[0-9]{2})?/?$ /archives/ [R=301,L]

# Attachment pages (e.g. /day-2-spinning-the-wheels/parsecommand/) -> the post
RewriteRule ^(day-1-setting-up-arduino-and-gathering-parts)/(uno_r3|uno_r3-2|uno_r3-3|arduino_ide)/?$ /$1/ [R=301,L]
RewriteRule ^(day-2-spinning-the-wheels)/(uno3connectionlayout|arduino_pin_setup|arduino_loop_code|parsecommand|moveforward|arduino_setup_final)/?$ /$1/ [R=301,L]
RewriteRule ^(day-3-controlling-the-robot-wirelessly)/(image|image-2)/?$ /$1/ [R=301,L]
RewriteRule ^(part-4-upgrading-to-raspberry-pi)/(raspberrypiconnections)/?$ /$1/ [R=301,L]

# Old image files (any WordPress resized/scaled variant) -> cleaned copies next to each post
RewriteRule ^wp-content/uploads/2025/06/(UNO_R3-2|Arduino_IDE)(-scaled|-[0-9]+x[0-9]+)?\.png$ /day-1-setting-up-arduino-and-gathering-parts/$1.png [R=301,L]
RewriteRule ^wp-content/uploads/2025/06/UNO_R3(-1)?(-scaled|-[0-9]+x[0-9]+)?\.png$ /day-1-setting-up-arduino-and-gathering-parts/UNO_R3-2.png [R=301,L]
RewriteRule ^wp-content/uploads/2025/06/(Arduino_pin_setup|Arduino_loop_code|parseCommand|moveForward)(-scaled|-[0-9]+x[0-9]+)?\.png$ /day-2-spinning-the-wheels/$1.png [R=301,L]
RewriteRule ^wp-content/uploads/2025/06/(UNO3connectionlayout|Arduino_setup_final)(-scaled|-[0-9]+x[0-9]+)?\.jpg$ /day-2-spinning-the-wheels/$1.jpg [R=301,L]
RewriteRule ^wp-content/uploads/2025/06/(image|image-1)(-scaled|-[0-9]+x[0-9]+)?\.png$ /day-3-controlling-the-robot-wirelessly/$1.png [R=301,L]
RewriteRule ^wp-content/uploads/2025/07/RaspberryPiConnections(-scaled|-[0-9]+x[0-9]+)?\.jpg$ /part-4-upgrading-to-raspberry-pi/RaspberryPiConnections.jpg [R=301,L]
RewriteRule ^wp-content/ - [G,L]
</IfModule>

# ---------------------------------------------------------------------------
# 4. Security headers
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000"
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
Header always set Cross-Origin-Opener-Policy "same-origin"
# Only our own files may load, plus giscus (comments). 'unsafe-inline' is needed by the
# theme's small inline scripts/styles and KaTeX; there is no user input on this static site.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://giscus.app; style-src 'self' 'unsafe-inline' https://giscus.app; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://giscus.app; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
Header always unset X-Powered-By
</IfModule>

# ---------------------------------------------------------------------------
# 5. Caching: fingerprinted CSS/JS forever, images a month, pages always fresh
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
<FilesMatch "\.[0-9a-f]{20,}\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|woff2?|ttf)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|xml|json|txt)$">
Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
</IfModule>
